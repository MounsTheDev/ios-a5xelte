-/*
- * For bsd/dev/herolte_drop.c: read count blocks of the root partition,
- * starting `back` blocks before the start of the log area (so back = 1 is
- * the last block below it), into dst. 0 or an errno.
- */
-#define HEROLTE_LOG_BLOCKS      (1 + (4u << 20) / UFS_BLOCK)
-int herolte_ufs_read_before_log(uint64_t back, uint32_t count, void *dst);
-
-int
-herolte_ufs_read_before_log(uint64_t back, uint32_t count, void *dst)
-{
-	if (!su.ready || back == 0 || count == 0 || count > back ||
-	    su.nblocks < HEROLTE_LOG_BLOCKS + back) {
-		return EINVAL;
-	}
-	uint64_t lba = su.first_block + su.nblocks - HEROLTE_LOG_BLOCKS - back;
-	int error = 0;
-	lck_mtx_lock(&herolte_ufs_lock);
-	for (uint32_t done = 0; done < count && !error;) {
-		uint32_t n = MIN(count - done, BOUNCE_SIZE / UFS_BLOCK);
-		error = ufs_read_blocks(lba + done, n);
-		if (!error) {
-			memcpy((uint8_t *)dst + (size_t)done * UFS_BLOCK,
-			    (const void *)(su.dma + DMA_BOUNCE), (size_t)n * UFS_BLOCK);
-		}
-		done += n;
-	}
-	lck_mtx_unlock(&herolte_ufs_lock);
-	return error;
-}
-
-/*
- * For bsd/dev/herolte_drop.c: SYNCHRONIZE CACHE of the root LUN, returning the driver's own
- * error (ETIMEDOUT, EIO). HFS issues the same command from F_FULLFSYNC but drops its error
- * (journal_flush returns 0 whatever DKIOCSYNCHRONIZE answered), so the DROP protocol asks again
- * here after every F_FULLFSYNC.
- */
-int herolte_ufs_sync(void);
-
-int
-herolte_ufs_sync(void)
-{
-	if (!su.ready) {
-		return ENXIO;
-	}
-	if (!su.writable) {
-		return EROFS;
-	}
-	lck_mtx_lock(&herolte_ufs_lock);
-	int error = ufs_sync_cache();
-	lck_mtx_unlock(&herolte_ufs_lock);
-	return error;
-}
-
-static void
-herolte_log_start(void)
-{
-	uint32_t on = 1;
-	thread_t thread;
-	PE_parse_boot_argn("herolog", &on, sizeof(on));
-	if (!on || !su.writable || su.nblocks < 2 * (1 + (4u << 20) / UFS_BLOCK)) {
-		return;
-	}
-	if (kernel_thread_start(herolte_log_thread, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
-	}
-	/* Thread backtraces of SpringBoard/backboardd (bsd/dev/sweet_sample.c). */
-	sweet_sample_start();
-}
