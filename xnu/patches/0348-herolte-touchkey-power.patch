diff --git a/bsd/dev/herolte_touchkey.c b/bsd/dev/herolte_touchkey.c
index 6028a7a..d20f7a5 100644
--- a/bsd/dev/herolte_touchkey.c
+++ b/bsd/dev/herolte_touchkey.c
@@ -51,7 +51,39 @@ extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 #define HTK_REG_PCB     0x02u
 #define HTK_REG_MODEL   0x14u
 
-static vm_offset_t htk_pins, htk_alive;
+/*
+ * Touch VDD is S2MPB02 LDO16 (TOUCH_VDD_3.3V) on HSI2C9 0x13680000, pins
+ * GPD1-4/5 function 2.  The Linux regulator core enables it at boot because
+ * the DT says regulator-boot-on; XNU has no regulator core, so S-Boot's
+ * state is all we get.  L16CTRL is register 0x2d, bit 7 enables, VSEL 0x6c
+ * is 3.3 V (600 mV + 108 * 25 mV).
+ */
+#define HTK_PMIC_PA      0x13680000u
+#define HTK_PMIC_PINS_PA 0x136D0000u
+#define HTK_PMIC_ADDR    0x59u
+#define HTK_LDO16_CTRL   0x2Du
+#define HTK_LDO16_EN     0x80u
+#define HTK_LDO16_3V3    0x6Cu
+
+#define HSI2C_CTL       0x00
+#define HSI2C_FIFO_CTL  0x04
+#define HSI2C_TRAILING  0x08
+#define HSI2C_INT_EN    0x20
+#define HSI2C_INT_STAT  0x24
+#define HSI2C_FIFO_STAT 0x30
+#define HSI2C_TX_DATA   0x34
+#define HSI2C_RX_DATA   0x38
+#define HSI2C_CONF      0x40
+#define HSI2C_AUTO_CONF 0x44
+#define HSI2C_TIMEOUT   0x48
+#define HSI2C_TRANS     0x50
+#define HSI2C_FS1       0x60
+#define HSI2C_FS2       0x64
+#define HSI2C_FS3       0x68
+#define HSI2C_SLA       0x6c
+#define HSI2C_ADDR      0x70
+
+static vm_offset_t htk_pins, htk_alive, htk_pmic, htk_pmic_pins;
 static int htk_sleep;
 static bool htk_started;
 
@@ -262,6 +294,170 @@ htk_state(unsigned pair)
 	return (pair == 2) ? 'P' : 'R';
 }
 
+/* GPD1 bank of pinctrl@136D0000: CON +0x40, DAT +0x44, PUD +0x48. */
+static void
+htk_pmic_pin_fn(unsigned pin, uint32_t fn)
+{
+	uint32_t v = htk_rd(htk_pmic_pins, 0x40u);
+	v = (v & ~(0xfu << (pin * 4))) | ((fn & 0xfu) << (pin * 4));
+	htk_wr(htk_pmic_pins, 0x40u, v);
+}
+
+static void
+htk_pmic_pin_pud(unsigned pin, uint32_t pull)
+{
+	uint32_t v = htk_rd(htk_pmic_pins, 0x48u);
+	v = (v & ~(0x3u << (pin * 2))) | ((pull & 0x3u) << (pin * 2));
+	htk_wr(htk_pmic_pins, 0x48u, v);
+}
+
+/*
+ * HSI2C9, same controller as the touchscreen's 0x14e10000 (bsd/dev/
+ * herolte_touch.c ht_message): AUTO mode, polled.  The block is in PERIC0,
+ * which is powered, and its functional clock is auto-gated; a transfer
+ * starts it.
+ */
+static bool
+htk_pmic_message(bool receive, uint8_t *bytes, unsigned count)
+{
+	uint32_t last = 0;
+	bool xfer_done = false;
+	unsigned done = 0;
+
+	if (count == 0 || count > 32) {
+		return false;
+	}
+	htk_wr(htk_pmic, HSI2C_INT_STAT, htk_rd(htk_pmic, HSI2C_INT_STAT));
+	htk_wr(htk_pmic, HSI2C_FIFO_CTL, 3u | (receive ? (1u << 4) : (1u << 16)));
+	htk_wr(htk_pmic, HSI2C_ADDR, HTK_PMIC_ADDR << 10);
+	htk_wr(htk_pmic, HSI2C_CTL, 9u | (receive ? 0x40u : 0x80u));
+	htk_wr(htk_pmic, HSI2C_INT_EN, 0xf80u | (receive ? 0x42u : 1u));
+	htk_wr(htk_pmic, HSI2C_AUTO_CONF, count | (receive ? 0x10000u : 0) |
+	    0x20000u | 0x80000000u);
+	for (unsigned us = 0; us < 50000; us++) {
+		uint32_t irq = htk_rd(htk_pmic, HSI2C_INT_STAT);
+		if (irq) {
+			last |= irq;
+			htk_wr(htk_pmic, HSI2C_INT_STAT, irq);
+		}
+		if (irq & 0xf00u) {
+			break;
+		}
+		if (irq & 0x80u) {
+			xfer_done = true;
+		}
+		if (receive) {
+			while (done < count &&
+			    ((htk_rd(htk_pmic, HSI2C_FIFO_STAT) >> 16) & 0x7fu)) {
+				bytes[done++] = (uint8_t)htk_rd(htk_pmic, HSI2C_RX_DATA);
+			}
+		} else {
+			while (done < count &&
+			    !(htk_rd(htk_pmic, HSI2C_FIFO_STAT) & (1u << 7))) {
+				htk_wr(htk_pmic, HSI2C_TX_DATA, bytes[done++]);
+			}
+		}
+		if (done == count && (xfer_done || receive)) {
+			htk_wr(htk_pmic, HSI2C_INT_EN, 0);
+			for (unsigned n = 0; n < 10000; n++) {
+				if (!(htk_rd(htk_pmic, HSI2C_TRANS) & (1u << 17))) {
+					return true;
+				}
+				delay(1);
+			}
+			break;
+		}
+		delay(1);
+	}
+	htk_wr(htk_pmic, HSI2C_INT_EN, 0);
+	return false;
+}
+
+static bool
+htk_pmic_init(void)
+{
+	if (!htk_pmic || !htk_pmic_pins) {
+		return false;
+	}
+	/* GPD1-4/5, function 2 (HSI2C9), no internal pull. */
+	htk_pmic_pin_pud(4, 0);
+	htk_pmic_pin_pud(5, 0);
+	htk_pmic_pin_fn(4, 2);
+	htk_pmic_pin_fn(5, 2);
+	htk_wr(htk_pmic, HSI2C_CTL, 0x80000009u);       /* SW reset, master */
+	htk_wr(htk_pmic, HSI2C_CTL, 0x00000009u);
+	htk_wr(htk_pmic, HSI2C_TIMEOUT, 0);
+	htk_wr(htk_pmic, HSI2C_FS1, 0x78787800u);
+	htk_wr(htk_pmic, HSI2C_FS2, 0x3c007878u);
+	htk_wr(htk_pmic, HSI2C_FS3, 0x000100f0u);
+	htk_wr(htk_pmic, HSI2C_SLA, 0x3cu);
+	htk_wr(htk_pmic, HSI2C_TRAILING, 0xfu);
+	htk_wr(htk_pmic, HSI2C_CONF, 0x80000000u);      /* AUTO mode */
+	htk_wr(htk_pmic, HSI2C_INT_EN, 0);
+	return true;
+}
+
+static bool
+htk_pmic_read(uint8_t reg, uint8_t *value)
+{
+	uint8_t b = reg;
+
+	if (!htk_pmic_message(false, &b, 1)) {
+		return false;
+	}
+	return htk_pmic_message(true, value, 1);
+}
+
+static bool
+htk_pmic_write(uint8_t reg, uint8_t value)
+{
+	uint8_t b[2] = { reg, value };
+	return htk_pmic_message(false, b, 2);
+}
+
+/*
+ * Read the S2MPB02 ID first: if the bus is dead, do not touch a regulator
+ * register.  Then read L16CTRL and, only if the voltage is already 3.3 V
+ * or the register is blank, enable it.
+ */
+static bool
+htk_power_on(void)
+{
+	uint8_t id = 0, ldo = 0, rb = 0;
+
+	htk_pmic = ml_io_map(HTK_PMIC_PA, 0x1000);
+	htk_pmic_pins = ml_io_map(HTK_PMIC_PINS_PA, 0x1000);
+	if (!htk_pmic || !htk_pmic_pins) {
+		printf("HEROLTE TK: pmic mapping failed\n");
+		return false;
+	}
+	printf("HEROLTE TK: gpd1 con=%#x dat=%#x pud=%#x\n",
+	    htk_rd(htk_pmic_pins, 0x40u), htk_rd(htk_pmic_pins, 0x44u),
+	    htk_rd(htk_pmic_pins, 0x48u));
+	if (!htk_pmic_init()) {
+		return false;
+	}
+	bool id_ok = htk_pmic_read(0x00, &id);
+	printf("HEROLTE TK: pmic id=%#x ok=%d\n", id, id_ok);
+	if (!id_ok) {
+		return false;
+	}
+	bool rd = htk_pmic_read(HTK_LDO16_CTRL, &ldo);
+	printf("HEROLTE TK: ldo16=%#x rd=%d\n", ldo, rd);
+	if (!rd) {
+		return false;
+	}
+	if (!(ldo & HTK_LDO16_EN)) {
+		bool wr = htk_pmic_write(HTK_LDO16_CTRL,
+		    (uint8_t)(HTK_LDO16_3V3 | HTK_LDO16_EN));
+		htk_msleep(5);
+		bool rr = htk_pmic_read(HTK_LDO16_CTRL, &rb);
+		printf("HEROLTE TK: ldo16 on wr=%d rb=%#x rr=%d\n", wr, rb, rr);
+		return wr && rr && (rb & HTK_LDO16_EN);
+	}
+	return true;
+}
+
 static void
 htk_thread(__unused void *arg, __unused wait_result_t wr)
 {
@@ -286,6 +482,10 @@ htk_thread(__unused void *arg, __unused wait_result_t wr)
 	    htk_rd(htk_alive, HTK_GPA0_CON), htk_rd(htk_alive, HTK_GPA0_DAT),
 	    htk_rd(htk_alive, HTK_GPA3_DAT));
 
+	if (!htk_power_on()) {
+		printf("HEROLTE TK: touch VDD not confirmed\n");
+	}
+	htk_msleep(5);
 	htk_bus_recover();
 	bool fw_ok = htk_read_reg(HTK_REG_FW, &fw);
 	bool pcb_ok = htk_read_reg(HTK_REG_PCB, &pcb);
