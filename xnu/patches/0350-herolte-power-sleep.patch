+/* The power thread's own channel, so a wake can move the CPU at once. */
+static void
+hg_pwr_msleep(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&hg_pwr_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
