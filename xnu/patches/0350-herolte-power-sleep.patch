+/*
+ * DCS short write to the panel through DSIM 0x13900000, as Samsung's
+ * decon_8890 dsim_reg_wr_tx_header (DSIM_PKTHDR 0x3c, DSIM_FIFOCTRL 0x4c
+ * bit 10 = header FIFO empty).  The bootloader leaves the DSIM in command
+ * mode and HSCLKEN; no other driver owns it.  A short packet is ~10 us.
+ */
+static void
+hg_dcs_short(uint8_t cmd)
+{
+	vm_offset_t dsim = ml_io_map(0x13900000u, 0x1000);
+	if (!dsim) {
+		return;
+	}
+	for (unsigned i = 0; i < 2000; i++) {
+		if (hg_rd(dsim, 0x4c) & (1u << 10)) {
+			break;
+		}
+		delay(1);
+	}
+	hg_wr(dsim, 0x34, 1u << 28);                    /* clear PH FIFO empty */
+	hg_wr(dsim, 0x3c, 0x05u | ((uint32_t)cmd << 8)); /* DCS short write */
+	delay(2000);
+}
