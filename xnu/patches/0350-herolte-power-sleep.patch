+/*
+ * Panel sleep/wake, called from SweetFramebuffer.cpp's RequestPowerChange on
+ * a real state change.  The CPU rate follows through herolte_screen_off_at
+ * and hg_power_thread (3 s debounce, 728 MHz); the GPU is moved here.
+ */
+void
+herolte_panel_power(bool on)
+{
+	if (on) {
+		(void)hg_gpu_rate(650);
+		/* hg_power_thread raises Mongoose now, not on its next 200 ms tick. */
+		thread_wakeup((event_t)&hg_pwr_sleep);
+		hg_dcs_short(0x11);     /* exit sleep */
+		hg_msleep(120);
+		hg_dcs_short(0x29);     /* display on */
+		printf("HEROLTE PWR: wake cpu=high gpu=%u dsi=11/29\n", hg_gpu_mhz_now);
+	} else {
+		hg_dcs_short(0x28);     /* display off */
+		hg_msleep(20);
+		hg_dcs_short(0x10);     /* enter sleep */
+		hg_msleep(50);          /* let the black frame's blit finish */
+		(void)hg_gpu_rate(338);
+		printf("HEROLTE PWR: sleep cpu=low(3s) gpu=%u dsi=28/10\n", hg_gpu_mhz_now);
 	}
-	printf("HEROLTE GPU: clock: G3D_PLL %#x -> %#x: %s\n", old, hg_rd(top, 0x1e0), locked ? "locked" : "NOT locked, put back");
