diff --git a/bsd/dev/herolte_gpu.c b/bsd/dev/herolte_gpu.c
index 574c7b1..b90be30 100644
--- a/bsd/dev/herolte_gpu.c
+++ b/bsd/dev/herolte_gpu.c
@@ -1218,9 +1218,16 @@ hg_draw(uint64_t hold, bool tex)
 		hg_wr32(scr, S_VARY_BUF + 12, 16 * 4);                          /* size */
 		hg_wr32(scr, S_VARY + 0, (1u << 9) | (((183u << 12) | 0xa88u) << 10));
 		hg_wr32(scr, S_VARY + 4, 0);
-		/* Sampler: bilinear, unnormalized coordinates, clamp to edge. */
+		/*
+		 * Sampler: nearest neighbour, unnormalized coordinates, clamp to edge.
+		 * Each 4-bit field is wrap mode in its low three bits (1 = clamp to
+		 * edge) and bit 3 the linear filter flag: bilinear was 9 = 8|1, so
+		 * nearest is 1. The panel blit upscales 750x1334 to 1440x2560 every
+		 * frame and the present costs 3-4 ms of a 16.7 ms budget; nearest
+		 * samples one texel where bilinear takes four.
+		 */
 		hg_wr32(scr, S_SAMPLER + 0, 0);
-		hg_wr32(scr, S_SAMPLER + 8, 9u | (9u << 4) | (9u << 8));
+		hg_wr32(scr, S_SAMPLER + 8, 1u | (1u << 4) | (1u << 8));
 		/* Texture: 180x320 RGBA8 UNORM, 2D, linear, 64-bit with strides,
 		 * then its one surface. */
 		hg_wr32(scr, S_TEXDESC + 0, (HG_TEX_W - 1) | ((HG_TEX_H - 1) << 16));
@@ -1576,7 +1583,9 @@ hgp_setup(void)
 	hg_wr32(scr, S_VARY_BUF + 8, 16);
 	hg_wr32(scr, S_VARY_BUF + 12, 16 * 4);
 	hg_wr32(scr, S_VARY + 0, (1u << 9) | (((183u << 12) | 0xa88u) << 10));
-	hg_wr32(scr, S_SAMPLER + 8, 9u | (9u << 4) | (9u << 8));
+	/* The panel blit's sampler: nearest neighbour instead of bilinear (9 = 8|1 per field, see the note in the
+	 * herogpu=9 setup above). One texel a sample instead of four, on 3.7 M panel pixels every frame. */
+	hg_wr32(scr, S_SAMPLER + 8, 1u | (1u << 4) | (1u << 8));
 	hg_wr32(scr, S_TEXDESC + 8, ((187u << 12) | 0x688u) | (2u << 22) | (2u << 24) | (3u << 28));
 	hg_wr32(scr, S_TEXDESC + 16, 0x688u);
 	hg_wr64(scr, S_TEX_PTRS, HG_SCR_VA + S_TEXDESC);
