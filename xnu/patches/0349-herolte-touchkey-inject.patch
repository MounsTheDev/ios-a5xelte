+/*
+ * Command write to BTNSTATUS, as abov_tk_i2c_write(client, ABOV_BTNSTATUS,
+ * &cmd, 1): start, addr+W, 0x00, cmd, stop.  This is the only data byte the
+ * driver writes to the controller; it carries the LED on/off command.
+ */
+static bool
+htk_write_cmd(uint8_t cmd)
+{
+	bool ok = false;
+
+	htk_start();
+	if (!htk_write_byte((uint8_t)(HTK_ADDR << 1))) {
+		goto out;
+	}
+	if (!htk_write_byte(HTK_REG_STATUS)) {
+		goto out;
+	}
+	if (!htk_write_byte(cmd)) {
+		goto out;
+	}
+	ok = true;
+out:
+	htk_stop();
+	return ok;
+}
+
+static void
+htk_led(int on)
+{
+	bool ok = htk_write_cmd(on ? HTK_CMD_LED_ON : HTK_CMD_LED_OFF);
+	printf("HEROLTE TK: led %s ok=%d\n", on ? "on" : "off", ok);
+}
+
+/* Keep the key backlight on for 3 s after the last touch. */
+static void
+htk_led_touch(void)
+{
+	clock_interval_to_deadline(3000, NSEC_PER_MSEC, &htk_led_deadline);
+	htk_led(1);
+}
+
+/* Left key: two Home presses 80 ms apart (down, 40 ms, up, 40 ms, ...). */
+static void
+htk_home_double(void)
+{
+	sweet_hid_key(3, 1);
+	htk_msleep(40);
+	sweet_hid_key(3, 0);
+	htk_msleep(40);
+	sweet_hid_key(3, 1);
+	htk_msleep(40);
+	sweet_hid_key(3, 0);
+}
+
+/* Right key: edge swipe, x 2 -> 320 at y 667, about 120 ms. */
+static void
+htk_swipe_back(void)
+{
+	const int y = 667;
+
+	sweet_hid_touch(0, 1, 2, y);
+	for (int x = 34; x <= 320; x += 32) {
+		htk_msleep(12);
+		sweet_hid_touch(0, 1, x, y);
+	}
+	htk_msleep(12);
+	sweet_hid_touch(0, 0, 320, y);
+}
+
+static bool
+htk_read_retry(uint8_t reg, uint8_t *value)
+{
+	for (int i = 0; i < 3; i++) {
+		if (htk_read_reg(reg, value)) {
+			return true;
+		}
+		htk_msleep(20);
+	}
+	return false;
+}
