diff --git a/bsd/dev/herolte_battery.c b/bsd/dev/herolte_battery.c
index f5e9619..f08a35c 100644
--- a/bsd/dev/herolte_battery.c
+++ b/bsd/dev/herolte_battery.c
@@ -38,6 +38,7 @@ volatile int herolte_fg_ma;
 volatile int herolte_fg_ac;             /* MAX77854 CHGIN_OK */
 volatile int herolte_fg_ac_valid;       /* the 0x66 read succeeded */
 volatile int herolte_fg_ac_raw;         /* CHG_INT_OK byte, for the log */
+volatile int herolte_fg_dtls;           /* CHG_DETAILS_00 byte */
 
 #define HSI2C_CTL       0x00
 #define HSI2C_FIFO_CTL  0x04
@@ -219,6 +220,23 @@ int
 herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, unsigned *full_mah)
 {
 	uint16_t soc, vcell, current, rem, full;
+	/*
+	 * Charger first, live, even if the gauge read fails.  0xB0 clears the
+	 * latched charger interrupt; 0xB2 bit 6 is CHGIN_OK; 0xB3 bits 6:5 are
+	 * CHGIN_DTLS (0 = no input).  Both must agree, so an unplug clears it.
+	 */
+	herolte_fg_ac_valid = 0;
+	herolte_fg_ac = 0;
+	if (fg_i2c) {
+		uint16_t chg = 0, dtls = 0, intreg = 0;
+		(void)fg_word_at(0x66, 0xB0, &intreg);
+		bool chg_ok = fg_word_at(0x66, 0xB2, &chg);
+		bool dtls_ok = fg_word_at(0x66, 0xB3, &dtls);
+		herolte_fg_ac_valid = chg_ok;
+		herolte_fg_ac_raw = chg & 0xff;
+		herolte_fg_dtls = dtls & 0xff;
+		herolte_fg_ac = chg_ok && (chg & 0x40) && (dtls_ok ? ((dtls & 0x60) != 0) : 1);
+	}
 	if (!fg_i2c || !fg_word(FG_REPSOC, &soc) || !fg_word(FG_VCELL, &vcell) ||
 	    !fg_word(FG_CURRENT, &current) || !fg_word(FG_REPCAP, &rem) ||
 	    !fg_word(FG_FULLCAP, &full)) {
@@ -237,12 +255,6 @@ herolte_fg_read(unsigned *percent, unsigned *mv, int *ma, unsigned *rem_mah, uns
 	*ma = (int)(((int64_t)(int16_t)current * 15625) / 100000);
 	herolte_fg_mv = *mv;
 	herolte_fg_ma = *ma;
-	/* The charger MFD is at 0x66 on the same bus: CHG_INT_OK 0xB2, bit 6 CHGIN_OK. */
-	uint16_t chg = 0;
-	bool chg_ok = fg_word_at(0x66, 0xB2, &chg);
-	herolte_fg_ac_valid = chg_ok;
-	herolte_fg_ac = chg_ok && (chg & 0x40);
-	herolte_fg_ac_raw = chg & 0xff;
 	*rem_mah = rem / 2u;
 	*full_mah = full / 2u;
 	return 0;
