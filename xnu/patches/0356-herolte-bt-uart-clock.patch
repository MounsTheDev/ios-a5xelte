index 26fefa3..dd1da01 100644
--- a/bsd/dev/herolte_bt.c
+++ b/bsd/dev/herolte_bt.c
@@ -61,6 +61,39 @@ static vm_offset_t bt_uart, bt_peric1, bt_fsys0, bt_alive;
 static bool bt_started;
 static int bt_sleep;
 
+/*
+ * (0356, reworked by 0357) The clock that was missing.  The bootloader never configured UART1:
+ * bt1 read it back as ulcon=0 ucon=0x3000 ubrdiv=0 ufrac=0, i.e. no line
+ * format and no divisor, so HCI_Reset went out over a UART that was not
+ * transmitting and the chip never answered.  ucon=0x3000 is only the two
+ * receive-timeout bits; the clock-selection field (bits 10:9) was zero, so
+ * the block was not even fed.  The CMU gates and the baud clock are therefore
+ * opened here before any divider is written, the way Linux's exynos8890 clock
+ * driver does for the UART:
+ *
+ *   0x14C80000 CMU_PERIC1  (gate 0x800; written, never read)
+ *
+ * 0357 removed the raw 0x10570000 read and the read-back of the CMU block:
+ * a gated block aborts on a read and nothing here proved it was gated on.
+ */
+#define BT_CMU_PERIC1_PA 0x14C80000u    /* UART1 gate (0x800); written, never read */
+
+/*
+ * (0362) The PMIC, through the HSI2C engine bsd/dev/herolte_battery.c already
+ * drives.  s2mps16 answers at 0x66 on hsi2c@10550000, a different controller
+ * from the charger's bus.
+ */
+extern int herolte_pmic_setup(void);
+extern int herolte_pmic_rd(uint8_t reg, uint8_t *value);
+extern int herolte_pmic_wr(uint8_t reg, uint8_t value);
+
+/* s2mps16 regulator control: LDO28 is VREG_BT, always-on and boot-on in the DTB. */
+#define PMIC_LDO28_CTRL 0x64
+#define PMIC_LDO28_ON   (1u << 6)
+/* The 32 kHz gate the combo chip needs for its sleep clock. */
+#define PMIC_32K_CTRL   0x00
+#define PMIC_32K_BT     (1u << 2)
+
 static uint32_t
 bt_rd(vm_offset_t base, uint32_t off)
 {
@@ -113,6 +146,158 @@ bt_gpio_out(vm_offset_t base, uint32_t con, uint32_t dat, uint32_t pud, unsigned
 	bt_wr(base, dat, v);
 }
 
+/* (0356) BT_HOST_WAKE (GPA2-3, ALIVE 0x10580000 +0x40): 0 while the chip holds it down. */
+static int
+bt_host_wake(void)
+{
+	return (int)((bt_rd(bt_alive, 0x44) >> 3) & 1u);
+}
+
+/*
+ * (0356) Wait for BT_HOST_WAKE to come back high after reset, instead of a
+ * fixed sleep: the BCM4359 drives it low while it boots and releases it when
+ * the HCI layer is up.  Returns the milliseconds spent, or the negation of the
+ * timeout when it never freed the line.
+ */
+static int
+bt_wait_host_wake(unsigned timeout_ms)
+{
+	for (unsigned ms = 0; ms < timeout_ms; ms++) {
+		if (bt_host_wake()) {
+			return (int)ms;
+		}
+		bt_msleep(1);
+	}
+	return -(int)timeout_ms;
+}
+
+/*
+ * The clock source actually in use, UCON bits 10:9, for the log and for the
+ * divisor that bt_uart_conf() derives from it.  Nothing else of the CMU is
+ * kept: the block is written, never read.
+ */
+static unsigned bt_uart_src;
+
+/*
+ * (0362) The two things the devicetree promises and nothing ever verified:
+ * VREG_BT (s2mps16 LDO28, 2.8 V, "regulator-always-on") and the chip's 32 kHz
+ * sleep clock.  "always-on" is a policy in the kernel, not a measurement, and
+ * a BCM4359 without LPO does not boot its ROM, does not drive HOST_WAKE and
+ * does not answer HCI.  Both are read, logged, and only written when the bit
+ * says off.
+ */
+static void
+bt_power_rails(void)
+{
+	uint8_t ldo = 0, clk = 0;
+	int ldo_ok = -1, clk_ok = -1;
+
+	if (herolte_pmic_setup() != 0) {
+		BT_LOG("HEROLTE BT: pmic unavailable, rails unread");
+		return;
+	}
+	ldo_ok = herolte_pmic_rd(PMIC_LDO28_CTRL, &ldo);
+	clk_ok = herolte_pmic_rd(PMIC_32K_CTRL, &clk);
+	BT_LOG("HEROLTE BT: pmic ldo28=%#x%s 32k=%#x%s (before%s)",
+	    ldo, ldo_ok == 0 ? "" : "?", clk, clk_ok == 0 ? "" : "?",
+	    (ldo == 0xff && clk == 0xff) ? ", bus silent" : "");
+	if (ldo_ok == 0 && !(ldo & PMIC_LDO28_ON)) {
+		(void)herolte_pmic_wr(PMIC_LDO28_CTRL, (uint8_t)(ldo | PMIC_LDO28_ON));
+		BT_LOG("HEROLTE BT: ldo28 was off, set on");
+	}
+	if (clk_ok == 0 && !(clk & PMIC_32K_BT)) {
+		(void)herolte_pmic_wr(PMIC_32K_CTRL, (uint8_t)(clk | PMIC_32K_BT));
+		BT_LOG("HEROLTE BT: 32k bt bit was off, set on");
+	}
+	if (ldo_ok == 0 && herolte_pmic_rd(PMIC_LDO28_CTRL, &ldo) == 0 &&
+	    clk_ok == 0 && herolte_pmic_rd(PMIC_32K_CTRL, &clk) == 0) {
+		BT_LOG("HEROLTE BT: pmic ldo28=%#x 32k=%#x (after)", ldo, clk);
+	}
+}
+
+/*
+ * (0356) Open the UART's clock: the CMU gate, a clock source, a divisor, then
+ * the block's own clock-select.  Nothing here depends on a previous state, so
+ * a cold run after the bootloader (which left everything at zero) works as
+ * well as a warm one from a driver that already powered the block.
+ */
+static void
+bt_uart_clock(void)
+{
+	/*
+	 * (0357) No blind read of a CMU block.  bt2 mapped 0x10570000 and
+	 * 0x14C80000 and dereferenced them at once; on this port a register of a
+	 * gated block is an external abort (herolte_gpu.c learned the same on the
+	 * Wi-Fi gate: far ...854, esr 0x96000210), and ml_io_map answering
+	 * non-NULL says nothing about the clock being on.  The UART's own pages are
+	 * already mapped and known to answer (S-Boot used the block), so the switch
+	 * clock is chosen there and only the two CMU writes are made, without
+	 * reading first: a write to a gated block is dropped, not aborted.
+	 *
+	 * UCON bits 10:9 are the clock source.  Samsung's exynos8890 clock driver
+	 * names source 0 "oscclk", 1 "sclk_uart1" (the PLL), 2 "sclk_uart1_user";
+	 * 1 is what Linux programs, and it is what bt2 tried to reach through the
+	 * CMU before reading it.
+	 */
+	uint32_t ucon = bt_rd(bt_uart, UART_UCON);
+	if (ucon == 0xffffffffu) {
+		BT_LOG("HEROLTE BT: uart regs dead, no clock to set");
+		return;
+	}
+	/* Source 1 (the PLL), keeping the baud clock switch in bit 8 clear. */
+	bt_wr(bt_uart, UART_UCON, (ucon & ~(3u << 9)) | (1u << 9));
+	bt_uart_src = (bt_rd(bt_uart, UART_UCON) >> 9) & 3u;
+	/* Gate 5 (UART1) and its bus gate 4: set only, never read back. */
+	vm_offset_t cmu = ml_io_map(BT_CMU_PERIC1_PA, 0x1000);
+	if (cmu) {
+		bt_wr(cmu, 0x800, 0x30u);                        /* parent gate, then bus gate */
+	}
+	BT_LOG("HEROLTE BT: clock ucon=%#x src=%u cmu=%s",
+	    bt_rd(bt_uart, UART_UCON), bt_uart_src,
+	    cmu ? "gate 0x30 written, not read" : "map failed, block untouched");
+}
+
+/*
+ * (0356) 8N1 from a known clock.  The bootloader left ulcon=0, ubrdiv=0 and
+ * ufrac=0, so both quotients are computed, not trusted: 100 MHz / (16 x
+ * 115200) = 54.25, i.e. 54 with a fractional part of 0.25 x 16 = 4.  A
+ * plausible value left by a warm boot is kept; anything else (0, all ones, out
+ * of range) is replaced.
+ */
+static void
+bt_uart_conf(void)
+{
+	uint32_t ulcon = bt_rd(bt_uart, UART_ULCON);
+	uint32_t ucon = bt_rd(bt_uart, UART_UCON);
+	uint32_t ubrdiv = bt_rd(bt_uart, UART_UBRDIV);
+	uint32_t ufrac = bt_rd(bt_uart, UART_UFRACVAL);
+	BT_LOG("HEROLTE BT: uart as found ulcon=%#x ucon=%#x ufcon=%#x umcon=%#x ubrdiv=%u ufrac=%u",
+	    ulcon, ucon, bt_rd(bt_uart, UART_UFCON), bt_rd(bt_uart, UART_UMCON), ubrdiv, ufrac);
+	bt_wr(bt_uart, UART_ULCON, 0x3);                        /* 8N1, one stop, no parity */
+	bt_wr(bt_uart, UART_UFCON, 0x7);                        /* reset both FIFOs */
+	bt_wr(bt_uart, UART_UFCON, 0x111);                      /* FIFO, 4/4 trigger */
+	bt_wr(bt_uart, UART_UMCON, 0x1);                        /* AFC/RTS */
+	/*
+	 * Clock select on the PCLK, transmitter and receiver running, and the
+	 * receive-timeout bits the bootloader already had.  They are polled, but the
+	 * block only shifts with the run bits set.
+	 */
+	uint32_t want = (ucon & 0x100u) | 0x3c5u;
+	if (ucon != 0xffffffffu) {
+		want |= ucon & 0x3000u;                         /* keep its RX timeout */
+		want |= ucon & (3u << 9);                       /* keep the clock source */
+	}
+	bt_wr(bt_uart, UART_UCON, want);
+	if (ubrdiv == 0 || ubrdiv > 1000) {
+		ubrdiv = 54;                                    /* 115200 from 100 MHz */
+		ufrac = 4;
+		bt_wr(bt_uart, UART_UBRDIV, ubrdiv);
+		bt_wr(bt_uart, UART_UFRACVAL, ufrac);
+	}
+	BT_LOG("HEROLTE BT: uart set ulcon=3 ucon=%#x ubrdiv=%u ufrac=%u",
+	    bt_rd(bt_uart, UART_UCON), bt_rd(bt_uart, UART_UBRDIV), bt_rd(bt_uart, UART_UFRACVAL));
+}
+
 static bool
 bt_tx_byte(uint8_t b)
 {
