-		ufrac = 20;
-	}
-	bt_wr(bt_uart, UART_UBRDIV, ubrdiv);
-	bt_wr(bt_uart, UART_UFRACVAL, ufrac);
+	/* The chip's own boot time, before HOST_WAKE is expected. */
+	bt_msleep(150);
+	int woke = bt_wait_host_wake(1500);
+	BT_LOG("HEROLTE BT: uart=0x%x reg_on=%d wake=%d host_wake=%d waited=%d ms",
+	    BT_UART_PA, (int)((bt_rd(bt_peric1, 0x64) >> 7) & 1u),
+	    (int)((bt_rd(bt_fsys0, 0x24) >> 3) & 1u), bt_host_wake(), woke);
+	/* (0356) 8N1 115200 from a known clock. */
