 	unsigned events = 0;
 
 	/* The rootfs and the drop zone are up by then. */
@@ -266,38 +450,53 @@ bt_thread(__unused void *arg, __unused wait_result_t wr)
 	bt_wr(bt_peric1, 0x00, (bt_rd(bt_peric1, 0x00) & ~0xffffu) | 0x2222u);
 	bt_wr(bt_peric1, 0x08, (bt_rd(bt_peric1, 0x08) & ~0xffu) | 0xffu);
 	bt_wr(bt_peric1, 0x0c, (bt_rd(bt_peric1, 0x0c) & ~0xffu) | 0xffu);
-	/* BT_REG_ON low, BT_WAKE high, BT_REG_ON high, 150 ms. */
-	bt_gpio_out(bt_peric1, 0x60, 0x64, 0x68, 7, 0);
-	bt_msleep(20);
-	bt_gpio_out(bt_fsys0, 0x20, 0x24, 0x28, 3, 1);
-	bt_gpio_out(bt_peric1, 0x60, 0x64, 0x68, 7, 1);
-	bt_msleep(150);
+	/* (0356) The block's own clock, before anything is written to it. */
+	bt_uart_clock();
+	/*
+	 * (0359) The devicetree is the authority on these three pins, and bt1 to
+	 * bt3 never consulted it:
+	 *
+	 *   pinctrl@14CC0000/bt-en        samsung,pins "gpj1-7"  function 1
+	 *   pinctrl@10E60000/bt-btwake    samsung,pins "gpi2-3"  function 1
+	 *   pinctrl@10580000/bt-hostwake  samsung,pins "gpa2-3"  input
+	 *
+	 * bt-en lives in the GPJ1 bank at PERIC1 +0x60, and the blanket write
+	 * above (0x2222 into PERIC1 +0x00) puts whole GPJ banks on function 2
+	 * for the UART before bt-en is ever configured.  A pin on the wrong
+	 * function shows its output latch in DAT while the pad drives nothing,
+	 * which is exactly the pair bt3 logged: reg_on=1 with host_wake=0.  So
+	 * bt-en is set to function 1 (output) with a pull-down after that
+	 * blanket write, and the order is the one the BCM4359 asks for:
+	 * BT_WAKE high first, then BT_REG_ON released, then a settle long
+	 * enough for the chip's ROM to come up and drive HOST_WAKE.
+	 */
+	bt_power_rails();
+	bt_pin_fn(bt_peric1, 0x00, 7, 1);                       /* GPJ1-7 bt-en: output */
+	bt_pin_pud(bt_peric1, 0x08, 7, 1);                      /* pull-down */
+	bt_pin_fn(bt_fsys0, 0x00, 3, 1);                        /* GPI2-3 bt-wake */
+	bt_gpio_out(bt_peric1, 0x60, 0x64, 0x68, 7, 0);         /* BT_REG_ON low */
+	bt_gpio_out(bt_fsys0, 0x20, 0x24, 0x28, 3, 1);          /* BT_WAKE high */
+	bt_msleep(50);
+	bt_gpio_out(bt_peric1, 0x60, 0x64, 0x68, 7, 1);         /* BT_REG_ON high */
+	/* The pad levels, not only the latches, before the chip is asked. */
+	BT_LOG("HEROLTE BT: bt-en con=%#x dat=%#x pud=%#x; bt-wake con=%#x dat=%#x",
+	    bt_rd(bt_peric1, 0x00), bt_rd(bt_peric1, 0x60), bt_rd(bt_peric1, 0x08),
+	    bt_rd(bt_fsys0, 0x00), bt_rd(bt_fsys0, 0x20));
+	/*
+	 * (0356) Wait for the chip's own sign of life instead of a fixed sleep:
+	 * BT_HOST_WAKE is driven low while it boots.  In bt1 the line read 0 just
+	 * after the 150 ms sleep and the HCI_Reset was sent anyway; here the wait
+	 * is bounded and the outcome is logged either way.
+	 */
 	bt_pin_fn(bt_alive, 0x40, 3, 0);                        /* host wake, input */
-	BT_LOG("HEROLTE BT: uart=0x%x reg_on=1 wake=1 host_wake=%d",
-	    BT_UART_PA, (int)((bt_rd(bt_alive, 0x44) >> 3) & 1u));
-	/* What the bootloader left, then 8N1 with RTS/CTS. */
-	ulcon = bt_rd(bt_uart, UART_ULCON);
-	ucon = bt_rd(bt_uart, UART_UCON);
-	ufcon = bt_rd(bt_uart, UART_UFCON);
-	umcon = bt_rd(bt_uart, UART_UMCON);
-	ubrdiv = bt_rd(bt_uart, UART_UBRDIV);
-	ufrac = bt_rd(bt_uart, UART_UFRACVAL);
-	BT_LOG("HEROLTE BT: uart as found ulcon=%#x ucon=%#x ufcon=%#x umcon=%#x ubrdiv=%u ufrac=%u",
-	    ulcon, ucon, ufcon, umcon, ubrdiv, ufrac);
-	bt_wr(bt_uart, UART_ULCON, 0x3);
-	bt_wr(bt_uart, UART_UFCON, 0x7);                        /* reset both FIFOs */
-	bt_wr(bt_uart, UART_UFCON, 0x111);                      /* FIFO, 4/4 trigger */
-	bt_wr(bt_uart, UART_UMCON, 0x1);                        /* AFC/RTS */
-	if (ucon == 0 || ucon == 0xffffffffu) {
-		ucon = 0x3c5;
-	}
