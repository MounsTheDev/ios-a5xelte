+/*
+ * (0361) A digest of the raw bytes, so the power thread dumps on any change
+ * rather than on the derived plug state.  bt4 gated the dump on an edge in
+ * "ac" that could never arrive, and the journal said nothing at all.
+ */
+unsigned
+herolte_fg_charger_digest(void)
+{
+	uint8_t a = 0, b = 0, c = 0, d = 0;
+
+	if (!fg_i2c) {
+		return 0;
+	}
+	(void)fg_byte_at(0x69, 0xB2, &a);
+	(void)fg_byte_at(0x69, 0xB3, &b);
+	(void)fg_byte_at(0x25, 0x02, &c);
+	(void)fg_byte_at(0x25, 0x01, &d);
+	return ((unsigned)a << 24) | ((unsigned)b << 16) | ((unsigned)c << 8) | d;
+}
