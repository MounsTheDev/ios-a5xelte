+/*
+ * (0365) The whole picture in one block: the three sub-addresses of the same
+ * chip side by side, plus the gauge's current.  One plug/unplug pair of dumps
+ * therefore shows which block moves, instead of one hypothesis per build.
+ */
+void
+herolte_fg_dump_charger(const char *why)
+{
+	uint16_t cur_raw = 0;
+
+	if (fg_word_at(0x36, 0x0A, &cur_raw)) {
+		printf("HEROLTE FG: 0x36 current raw=%#x (%d mA) vcell=%#x\n",
+		    (unsigned)cur_raw, herolte_fg_current_mA(), 0);
+	}
+	printf("HEROLTE FG: ---- dump (%s) ----\n", why);
+	for (unsigned i = 0; i < 8; i++) {
+		uint8_t top = 0, chg = 0, muic = 0;
+		bool t_ok = fg_byte_at(0x66, (uint8_t)(0xB0 + i), &top);
+		bool c_ok = fg_byte_at(0x69, (uint8_t)(0xB0 + i), &chg);
+		bool m_ok = fg_byte_at(0x25, (uint8_t)(0xB0 + i), &muic);
+		printf("HEROLTE FG: 0x%02x top=%#02x%s chg=%#02x%s muic=%#02x%s\n",
+		    0xB0 + i, top, t_ok ? "" : "?", chg, c_ok ? "" : "?",
+		    muic, m_ok ? "" : "?");
+	}
+	/* The MUIC's own status bytes, where Samsung keeps vbvolt and chgtyp. */
+	for (unsigned i = 0; i < 4; i++) {
+		uint8_t v = 0;
+		bool ok = fg_byte_at(0x25, (uint8_t)(0x01 + i), &v);
+		printf("HEROLTE FG: 0x25:0x%02x = %#02x (%s)%s\n", 0x01 + i,
+		    (unsigned)v, ok ? "answered" : "no answer",
+		    (0x02 == 0x01 + i && (v & 0x02)) ? " vbvolt" : "");
+	}
+	printf("HEROLTE FG: ---- dump end ----\n");
+}
