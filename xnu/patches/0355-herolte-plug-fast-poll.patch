+/*
+ * (0361) A digest of the raw charger window, so the power thread can dump on
+ * any byte changing rather than on the derived plug state.  bt4 conditioned
+ * the dump on an edge in "ac", and ac could never change while 0xB2 read
+ * 0xff, so the dump never ran and told us nothing.
+ */
+/*
+ * (0362) The PMIC on the other HSI2C bus.  s2mps16 is at 0x66 on
+ * hsi2c@10550000, while the charger sits at 0x66 on hsi2c@13650000: two
+ * different buses, the same device address.  The Bluetooth side needs to
+ * read and, if necessary, set LDO28 (VREG_BT) and the 32 kHz enable, and this
+ * driver already owns a working HSI2C engine, so the two byte-sized helpers
+ * live here instead of a second copy of the protocol in herolte_bt.c.
+ */
+static vm_offset_t pmic_i2c;
+
+int
+herolte_pmic_setup(void)
+{
+	vm_offset_t pins;
+
+	if (pmic_i2c) {
+		return 0;
+	}
+	pmic_i2c = ml_io_map(PMIC_HSI2C_PA, 0x1000);
+	pins = ml_io_map(PMIC_PINS_PA, 0x1000);
+	if (!pmic_i2c || !pins) {
+		pmic_i2c = 0;
+		return -1;
+	}
+	/* ETC0-0 and ETC0-1 as function 2 (HSI2C), no pull: the DTB's hs-i2c15-bus. */
+	fg_wr(pins, 0x00, (fg_rd(pins, 0x00) & ~0xffu) | 0x22u);
+	fg_wr(pins, 0x08, (fg_rd(pins, 0x08) & ~0xfu) | 0x0u);
+	fg_wr(pmic_i2c, HSI2C_CTL, 0x80000009u);
+	fg_wr(pmic_i2c, HSI2C_CTL, 0x00000009u);
+	fg_wr(pmic_i2c, HSI2C_TIMEOUT, 0);
+	fg_wr(pmic_i2c, HSI2C_FS1, 0x78787800u);
+	fg_wr(pmic_i2c, HSI2C_FS2, 0x3c007878u);
+	fg_wr(pmic_i2c, HSI2C_CONF, 0x80000000u);
+	return 0;
+}
+
+int
+herolte_pmic_rd(uint8_t reg, uint8_t *value)
+{
+	uint8_t b[2];
+
+	if (!pmic_i2c) {
+		return -1;
+	}
+	if (!fg_message_at(PMIC_ADDR, false, &reg, 1, false) ||
+	    !fg_message_at(PMIC_ADDR, true, b, 1, true)) {
+		return -1;
+	}
+	*value = b[0];
+	return 0;
+}
+
+int
+herolte_pmic_wr(uint8_t reg, uint8_t value)
+{
+	uint8_t b[2];
+
+	if (!pmic_i2c) {
+		return -1;
+	}
+	b[0] = reg;
+	b[1] = value;
+	return fg_message_at(PMIC_ADDR, false, b, 2, true) ? 0 : -1;
+}
+
+unsigned
+herolte_fg_charger_digest(void)
+{
+	uint8_t b0 = 0, b2 = 0, b3 = 0;
+
+	if (!fg_i2c) {
+		return 0;
+	}
+	(void)fg_byte_at(0x66, 0xB0, &b0);
+	(void)fg_byte_at(0x66, 0xB2, &b2);
+	(void)fg_byte_at(0x66, 0xB3, &b3);
+	return ((unsigned)b0 << 16) | ((unsigned)b2 << 8) | (unsigned)b3;
+}
