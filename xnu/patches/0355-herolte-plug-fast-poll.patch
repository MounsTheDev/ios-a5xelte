+/*
+ * (0355) The plug icon's own clock.  poll() costs fourteen HSI2C reads (three
+ * tries each) and must not run four times a second, so the fast timer reads
+ * only the charger's two status bytes.  When they agree with what was
+ * published, nothing happens; when they do not, the whole source is
+ * republished at once, so setExternalConnected(false) and setIsCharging(false)
+ * reach powerd in the same tick the cable left, with no 30 s wait.
+ *
+ * A failed read counts as "no cable": an icon that disappears a moment early
+ * is better than a lightning bolt that stays after the user pulled the plug.
+ */
+void
+SweetBattery::chargerPoll(void)
+{
+	bool ok = herolte_fg_charger() == 0;
+	bool ac = ok && herolte_fg_ac != 0;
+	if (fPublished && ac == fExternal) {
+		return;
+	}
+	IOLog("SWEET BATTERY: plug %s ac_raw=%#x dtls=%#x (%s)\n",
+	    ac ? "in" : "out", (unsigned)herolte_fg_ac_raw,
+	    (unsigned)herolte_fg_dtls,
+	    !ok ? "read failed" : ((herolte_fg_ac_raw & 0xff) == 0xff ? "no ack" : "read"));
+	poll();
+}
