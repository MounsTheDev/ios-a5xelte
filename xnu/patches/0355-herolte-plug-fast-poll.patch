+/*
+ * (0360) Which charger register actually answers on this board.
+ *
+ * The TWRP devicetree has one node, max77854@66, and a running Android
+ * exposes exactly one bound driver, 1-0066 max77854, whose power_supply
+ * reports online=3, present=1, current_now=1000, status=Charging with the
+ * cable in.  So 0x66 is the right address and 0xB2/0xB3 are the wrong
+ * registers: both come back 0xff whether the cable is in or out.  1-0069
+ * exists but is bound to the dummy driver, so the charger block is not
+ * there either.  This dump prints the whole status window once, so a single
+ * journal says which offset carries CHGIN.
+ */
+void
+herolte_fg_dump_charger(const char *why)
+{
+	static const char *names[8] = {
+		"int", "int2", "ok", "dtls", "B4", "B5", "B6", "B7"
+	};
+
+	if (!fg_i2c) {
+		printf("HEROLTE FG: dump %s: no i2c\n", why);
+		return;
+	}
+	printf("HEROLTE FG: ---- dump (%s) ----\n", why);
+	for (unsigned i = 0; i < 8; i++) {
+		uint8_t v = 0;
+		bool ok = fg_byte_at(0x66, (uint8_t)(0xB0 + i), &v);
+		printf("HEROLTE FG: 0x66:0x%02x %-5s = %#02x (%s)\n",
+		    0xB0 + i, names[i], (unsigned)v, ok ? "answered" : "no answer");
+	}
+	/*
+	 * The low window as well: an MUIC or a charger detail register that
+	 * flips with the cable can live below 0xB0, and this costs one boot.
+	 */
+	for (unsigned i = 0; i < 0x20; i++) {
+		uint8_t v = 0;
+		bool ok = fg_byte_at(0x66, (uint8_t)i, &v);
+		printf("HEROLTE FG: 0x66:0x%02x = %#02x (%s)\n", i, (unsigned)v,
+		    ok ? "answered" : "no answer");
+	}
+	/* The gauge half of the same chip, which is known to answer. */
+	for (unsigned i = 0; i < 3; i++) {
+		static const uint8_t greg[3] = { 0x00, 0x0A, 0x0B };
+		uint16_t v = 0;
+		bool ok = fg_word_at(0x36, greg[i], &v);
+		printf("HEROLTE FG: 0x36:0x%02x = %#04x (%s)\n", greg[i],
+		    (unsigned)v, ok ? "answered" : "no answer");
+	}
+	printf("HEROLTE FG: ---- dump end ----\n");
+}
