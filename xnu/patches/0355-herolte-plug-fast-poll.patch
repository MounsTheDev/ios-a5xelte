+/*
+ * (0363) One byte, for the 8-bit peripherals.
+ *
+ * The gauge at 0x36 is a 16-bit device: a read of register n returns n and
+ * n+1, which is why fg_word_at() asks for two bytes.  The MFD half of the
+ * same chip (0x66) and the PMIC s2mps16 (0x66 on the other bus) are 8-bit
+ * maps, and asking them for two bytes leaves the controller clocking a byte
+ * that was never sent, so the FIFO hands back 0xff for everything that
+ * follows.  This asks for exactly one byte and is what those two use now.
+ */
+static bool
+fg_byte_at(uint8_t addr, uint8_t reg, uint8_t *value)
+{
+	uint8_t b = 0;
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		if (fg_message_at(addr, false, &reg, 1, false) &&
+		    fg_message_at(addr, true, &b, 1, true)) {
+			*value = b;
+			return true;
+		}
+		delay(500);
+	}
+	return false;
+}
