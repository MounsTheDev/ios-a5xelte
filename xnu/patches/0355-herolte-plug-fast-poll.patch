+static bool
+fg_charger_current(int16_t *value)
+{
+	uint16_t raw = 0;
+
+	if (!fg_word_at(0x36, 0x0A, &raw)) {
+		return false;
+	}
+	*value = (int16_t)raw;
+	return true;
