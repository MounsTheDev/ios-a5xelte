+/*
+ * (0362) The PMIC on the other HSI2C controller.  s2mps16 is at 0x66 on
+ * hsi2c@10550000, while the charger sits at 0x66 on hsi2c@13650000: two
+ * different controllers, the same device address.
+ */
+static vm_offset_t pmic_i2c;
+
+int
+herolte_pmic_setup(void)
+{
+	vm_offset_t pins;
+
+	if (pmic_i2c) {
+		return 0;
+	}
+	pmic_i2c = ml_io_map(PMIC_HSI2C_PA, 0x1000);
+	pins = ml_io_map(PMIC_PINS_PA, 0x1000);
+	if (!pmic_i2c || !pins) {
+		pmic_i2c = 0;
+		return -1;
+	}
+	/* ETC0-0 and ETC0-1 as function 2 (HSI2C), no pull: hs-i2c15-bus. */
+	fg_wr(pins, 0x00, (fg_rd(pins, 0x00) & ~0xffu) | 0x22u);
+	fg_wr(pins, 0x08, (fg_rd(pins, 0x08) & ~0xfu) | 0x0u);
+	fg_wr(pmic_i2c, HSI2C_CTL, 0x80000009u);
+	fg_wr(pmic_i2c, HSI2C_CTL, 0x00000009u);
+	fg_wr(pmic_i2c, HSI2C_TIMEOUT, 0);
+	fg_wr(pmic_i2c, HSI2C_FS1, 0x78787800u);
+	fg_wr(pmic_i2c, HSI2C_FS2, 0x3c007878u);
+	fg_wr(pmic_i2c, HSI2C_CONF, 0x80000000u);
+	return 0;
+}
+
+/* (0366) What that controller actually looks like, for the ldo28=0xff case. */
+void
+herolte_pmic_dump(void)
+{
+	if (!pmic_i2c) {
+		printf("HEROLTE PMIC: not mapped\n");
+		return;
+	}
+	printf("HEROLTE PMIC: ctl=%#x conf=%#x fs1=%#x fs2=%#x inten=%#x intstat=%#x\n",
+	    fg_rd(pmic_i2c, HSI2C_CTL), fg_rd(pmic_i2c, HSI2C_CONF),
+	    fg_rd(pmic_i2c, HSI2C_FS1), fg_rd(pmic_i2c, HSI2C_FS2),
+	    fg_rd(pmic_i2c, HSI2C_INT_EN), fg_rd(pmic_i2c, HSI2C_INT_STAT));
+	{
+		vm_offset_t pins = ml_io_map(PMIC_PINS_PA, 0x1000);
+		if (pins) {
+			printf("HEROLTE PMIC: etc0 con=%#x dat=%#x pud=%#x\n",
+			    fg_rd(pins, 0x00), fg_rd(pins, 0x04), fg_rd(pins, 0x08));
+		}
+	}
+}
+
+int
+herolte_pmic_rd(uint8_t reg, uint8_t *value)
+{
+	uint8_t b[1];
+
+	if (!pmic_i2c) {
+		return -1;
+	}
+	if (!fg_message_at(PMIC_ADDR, false, &reg, 1, false) ||
+	    !fg_message_at(PMIC_ADDR, true, b, 1, true)) {
+		return -1;
+	}
+	*value = b[0];
+	return 0;
+}
+
+int
+herolte_pmic_wr(uint8_t reg, uint8_t value)
+{
+	uint8_t b[2];
+
+	if (!pmic_i2c) {
+		return -1;
+	}
+	b[0] = reg;
+	b[1] = value;
+	return fg_message_at(PMIC_ADDR, false, b, 2, true) ? 0 : -1;
+}
